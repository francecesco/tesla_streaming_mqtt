# ─────────────────────────────────────────────────────────────────────────────
# Configurazione dell'installazione. Copia in config.env (NON versionato) e compila.
# Formato: CHIAVE=valore (sintassi shell, senza spazi attorno a '=').
# I segreti NON vanno qui ma in credentials.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Tesla ────────────────────────────────────────────────────────────────────
# Regione Fleet API dell'account: eu (Europa/Medio Oriente/Africa) | na (Nord America/APAC)
TESLA_REGION=eu
# Dominio partner dell'app Tesla = nome pubblico Tailscale Funnel del server.
# Ricavalo sul server con: tailscale status --json | grep -m1 DNSName   (senza punto finale)
TESLA_DOMAIN=myserver.tailXXXXXX.ts.net
# Hostname/porta a cui l'auto invia i dati. L'hostname DEVE stare nel dominio partner.
# Porta: 8443 o 10000 (Funnel ammette solo 443/8443/10000; la 443 serve i file statici).
TELEMETRY_HOST=${TESLA_DOMAIN}
TELEMETRY_PORT=8443
# Validita' della configurazione inviata all'auto (giorni). Rinnovare prima della scadenza.
CONFIG_EXP_DAYS=360

# ── Server (host Linux con Docker + Tailscale nativo) ───────────────────────
# Destinazione SSH usata solo come promemoria nei comandi del README (es. utente@nas)
SERVER_SSH=user@myserver
# Cartella dati sul server (config, certificati, file statici)
SERVER_DATA_DIR=/opt/fleet-telemetry
# Immagine ufficiale del server di telemetria (fissare la versione)
FT_IMAGE=tesla/fleet-telemetry:v0.9.5
# Porta locale (solo 127.0.0.1) su cui il container ascolta; Funnel inoltra qui
FT_LOCAL_PORT=4443

# ── MQTT ─────────────────────────────────────────────────────────────────────
# Broker MQTT raggiungibile dal server (es. Mosquitto di Home Assistant)
MQTT_BROKER=192.168.1.10:1883
MQTT_USER=fleet-telemetry
# La password viene chiesta da server/setup.sh e non va scritta qui
MQTT_TOPIC_BASE=tesla

# ── Strumenti lato amministrazione ───────────────────────────────────────────
# Release di teslamotors/vehicle-command da cui compilare tesla-http-proxy
VC_TAG=v0.4.1
# Porta locale del proxy durante 04-telemetry-config.sh (solo 127.0.0.1)
PROXY_PORT=4443
